# Host to bind the ASGI server to.
MEADOWS_HOST=0.0.0.0

# Port to bind the ASGI server to.
MEADOWS_PORT=8080

# Path to the JWT secret key (shared with meadows-client / meadows-bot).
MEADOWS_JWT_SECRET=./shared_keys/jwt.key

# Directory where JSONL message stores live (one file per group).
MEADOWS_MESSAGES_DIR=./messages

# CORS origins allowed for the Socket.IO server (comma-separated or "*").
MEADOWS_CORS_ORIGINS=*

# Debug logging (0 or 1).
MEADOWS_DEBUG=0

# Traefik routing (project prefix + hosting domain).
PROJECT=meadows
HOSTINGDOMAIN=localhost
